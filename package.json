{
  "name": "kivrn",
  "productName": "Kivrn",
  "version": "1.5.0",
  "description": "Offline infinite-canvas notes app for Windows. Monochrome, blocky, unlimited space.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "author": "Josef",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.josef.kivrn",
    "productName": "Kivrn",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "shortcutName": "Kivrn",
      "createDesktopShortcut": true,
      "artifactName": "Kivrn-${version}-setup.exe"
    },
    "afterPack": "build/after-pack.js",
    "portable": {
      "artifactName": "Kivrn-${version}-portable.exe",
      "unpackDirName": "Kivrn"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
